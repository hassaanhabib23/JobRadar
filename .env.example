# JobRadar configuration.
# Copy to .env and fill in. Placeholders only in this file — never commit real secrets.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Database -------------------------------------------------------------
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Asia/Karachi

# --- Frontend -------------------------------------------------------------
# Baked into /config.json by the frontend container entrypoint at start-up,
# so one image runs in both dev and prod.
API_BASE_URL=/api

# --- Scraping (milestone 10) ---------------------------------------------
# Optional residential proxies for jobspy, comma-separated. Off by default.
JOBSPY_PROXIES=

# --- Seed data (milestone 6) ---------------------------------------------
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
